{
  "manifest_version": 2,
  "name": "CEIR Checker",
  "version": "1.0.0",
  "description": "CEIR Checker userscript packaged as a GeckoView content extension.",
  "browser_specific_settings": { "gecko": { "id": "ceir-checker@local" } },
  "content_scripts": [{
    "matches": ["https://ceir.gov.mm/*"],
    "js": ["ceir-checker.user.js"],
    "run_at": "document_idle"
  }]
}
