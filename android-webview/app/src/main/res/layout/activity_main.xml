        <Button android:id="@+id/backButton" android:text="‹" android:textSize="25sp" android:textColor="#67E8F9" android:backgroundTint="#17223A" android:layout_width="48dp" android:layout_height="44dp" />
        <Button android:id="@+id/forwardButton" android:text="›" android:textSize="25sp" android:textColor="#67E8F9" android:backgroundTint="#17223A" android:layout_width="48dp" android:layout_height="44dp" />
